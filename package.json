{
  "name": "@viaanix/number-5",
  "version": "0.1.1",
  "description": "Agentic workflows built on docker-agent, and j5, the launcher that runs them against any project checkout",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Viaanix/number-5.git"
  },
  "bin": {
    "j5": "launcher/src/cli.ts"
  },
  "files": [
    "launcher/src",
    "workflows",
    "!workflows/**/test",
    "skills",
    "containers/pi-openai-proxy"
  ],
  "type": "module",
  "imports": {
    "#launcher/*": "./launcher/src/*",
    "#launcher-test/*": "./launcher/test/*"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp lint --fix && vp fmt",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint:shell": "bash scripts/lint-shell.sh",
    "test": "bun test --timeout=30000",
    "flavors": "bun scripts/generate-flavors.ts",
    "validate:teams": "bun scripts/validate-teams.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run lint:shell && bun run test && bun run validate:teams",
    "prepare": "vp config"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
