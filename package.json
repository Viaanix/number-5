{
  "name": "docker-agent-workflows",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:shell": "bash scripts/lint-shell.sh",
    "test": "bun test",
    "test:shell": "bats tests",
    "validate:teams": "bun scripts/validate-teams.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run lint:shell && bun run test && bun run test:shell && bun run validate:teams"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  }
}
